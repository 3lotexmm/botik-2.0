import discord
from discord.ext import commands

class ConsoleCatalog(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @commands.Cog.listener()
    async def on_ready(self):
        await self.bot.wait_until_ready()
        
        # Считаем статистику команд
        total_slash = len(self.bot.tree.get_commands())
        total_text = len(self.bot.commands)
        total_commands = total_slash + total_text
        
        # Анализ модулей
        loaded_modules = list(self.bot.extensions.keys())
        total_loaded = len(loaded_modules)
        
        # Вывод в консоль
        print("\n" + "=" * 70)
        print(f"[*] СТАТИСТИКА КОМАНД:")
        print(f"   Всего команд: {total_commands}")
        print(f"   Слеш-команд: {total_slash}")
        print(f"   Текстовых команд: {total_text}")
        print(f"   Загружено модулей: {total_loaded}")
        
        # Проверка на наличие ошибок (если в консоли были ошибки, это уже видно, но мы добавим подсказку)
        print(f"   Статус: OK (все модули загружены)" if total_loaded > 0 else "   Статус: Ошибка загрузки!")
        print("=" * 70)
        print()

async def setup(bot):
    await bot.add_cog(ConsoleCatalog(bot))
