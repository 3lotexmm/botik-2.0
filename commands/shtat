    @app_commands.command(name="remove-shtat", description="Закрыть набор в штат")
    @app_commands.default_permissions(administrator=True)
    async def slash_remove_shtat(self, interaction: discord.Interaction):
        if not self.is_active:
            await interaction.response.send_message("❌ Набор уже закрыт или не был создан.", ephemeral=True)
            return
        
        if self.panel_message:
            try:
                await self.panel_message.delete()
            except:
                pass
        
        transcript_lines = []
        async for msg in interaction.channel.history(limit=1000):
            if not msg.author.bot:
                transcript_lines.append(f"[{msg.created_at.strftime('%H:%M:%S')}] {msg.author.display_name}: {msg.content}")
        
        transcript_text = "\n".join(transcript_lines[::-1]) if transcript_lines else "Нет сообщений"
        file_path = f"transcript_shtat_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
        with open(file_path, "w", encoding="utf-8") as f:
            f.write(f"ТРАНСКРИПТ НАБОРА В ШТАТ\n")
            f.write("="*40 + "\n\n")
            f.write(transcript_text)

        log_channel = discord.utils.get(interaction.guild.channels, name="log-shtat")
        if not log_channel:
            log_channel = await interaction.guild.create_text_channel("log-shtat")
            await log_channel.set_permissions(interaction.guild.default_role, read_messages=False, send_messages=False)

        embed = discord.Embed(
            title="🔒 Набор в штат закрыт",
            description="Набор персонала завершён. Транскрипт сохранён.",
            color=0xe74c3c
        )
        embed.set_footer(text="Horizon Project • Система набора в штат v1.0")
        
        await log_channel.send(embed=embed, file=discord.File(file_path, filename=f"recruitment_log.txt"))
        os.remove(file_path)
        
        self.is_active = False
        await interaction.response.send_message("✅ Набор закрыт. Транскрипт сохранён.", ephemeral=True)

