    @commands.Cog.listener()
    async def on_voice_state_update(self, member, before, after):
        if member.bot:
            return

        # Игнорируем изменения микрофона/звука
        if (before.channel == after.channel and 
            (before.self_mute != after.self_mute or before.self_deaf != after.self_deaf)):
            return

        embed = discord.Embed(
            color=0x9b59b6,
            timestamp=datetime.datetime.utcnow()
        )
        embed.add_field(name="👤 Участник", value=member.mention, inline=True)

        moved_by_admin = False
        moved_by_who = None
        
        await asyncio.sleep(1)
        try:
            async for entry in member.guild.audit_logs(limit=10, after=datetime.datetime.utcnow() - datetime.timedelta(seconds=10)):
                if entry.action == discord.AuditLogAction.member_move:
                    if entry.target.id == member.id:
                        moved_by_admin = True
                        moved_by_who = entry.user
                        break
        except:
            pass

        if before.channel is None and after.channel is not None:
            embed.title = "🔊 Присоединился к голосовому каналу"
            embed.add_field(name="📂 Канал", value=after.channel.mention, inline=True)
        elif before.channel is not None and after.channel is None:
            embed.title = "🔇 Покинул голосовой канал"
            embed.add_field(name="📂 Канал", value=before.channel.mention, inline=True)
        elif before.channel != after.channel:
            if moved_by_admin and moved_by_who:
                embed.title = "🔄 Перемещён администратором"
                embed.add_field(name="➡️ Был", value=before.channel.mention, inline=True)
                embed.add_field(name="⬅️ Стал", value=after.channel.mention, inline=True)
                embed.add_field(name="⚡ Кто переместил", value=moved_by_who.mention, inline=False)
            else:
                embed.title = "🔄 Переместился самостоятельно"
                embed.add_field(name="➡️ Был", value=before.channel.mention, inline=True)
                embed.add_field(name="⬅️ Стал", value=after.channel.mention, inline=True)

        await self.send_log("orbit", embed)

