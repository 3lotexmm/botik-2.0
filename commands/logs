    @commands.Cog.listener()
    async def on_member_remove(self, member):
        await asyncio.sleep(2)
        action_taker = None
        action_type = "Вышел"
        reason = "Не указана"
        
        try:
            async for entry in member.guild.audit_logs(limit=10, after=datetime.datetime.utcnow() - datetime.timedelta(seconds=10)):
                if entry.target.id == member.id:
                    if entry.action == discord.AuditLogAction.kick:
                        action_type = "Был кикнут"
                        action_taker = entry.user
                        reason = entry.reason or "Причина не указана"
                        break
                    elif entry.action == discord.AuditLogAction.ban:
                        action_type = "Был забанен"
                        action_taker = entry.user
                        reason = entry.reason or "Причина не указана"
                        break
        except:
            pass

        if action_taker:
            embed = discord.Embed(
                title=f"🛑 Участник {action_type}",
                description=f"**{member.display_name}** {action_type}.",
                color=0xe74c3c,
                timestamp=datetime.datetime.utcnow()
            )
            embed.add_field(name="👤 Участник", value=f"{member.mention} ({member.id})", inline=True)
            embed.add_field(name="⚡ Кто наказал", value=action_taker.mention, inline=True)
            if reason and reason != "Не указана":
                embed.add_field(name="📝 Причина", value=reason, inline=False)
        else:
            embed = discord.Embed(
                title="👋 Участник покинул сервер",
                description=f"**{member.display_name}** вышел с сервера.",
                color=0xe74c3c,
                timestamp=datetime.datetime.utcnow()
            )
            embed.add_field(name="📛 Имя", value=member.name, inline=True)
            embed.add_field(name="🆔 ID", value=member.id, inline=True)
        
        embed.set_footer(text=f"Всего участников: {len(member.guild.members)}")
        await self.send_log("hellogyyd", embed)

