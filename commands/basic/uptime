import discord
from discord import app_commands
from discord.ext import commands
import time

class Uptime(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @app_commands.command(name="uptime", description="Показать время работы бота")
    async def slash_uptime(self, interaction: discord.Interaction):
        seconds = int(time.time() - self.bot.start_time)
        hours = seconds // 3600
        minutes = (seconds % 3600) // 60
        secs = seconds % 60

        embed = discord.Embed(
            title="⏱️ Время работы бота",
            description=f"Бот работает: **{hours:02d}ч {minutes:02d}м {secs:02d}с**",
            color=0x3498db
        )
        embed.set_footer(text=f"Запросил {interaction.user.name}")
        await interaction.response.send_message(embed=embed)

    @commands.command(name="uptime")
    async def text_uptime(self, ctx):
        seconds = int(time.time() - self.bot.start_time)
        hours = seconds // 3600
        minutes = (seconds % 3600) // 60
        secs = seconds % 60

        embed = discord.Embed(
            title="⏱️ Время работы бота",
            description=f"Бот работает: **{hours:02d}ч {minutes:02d}м {secs:02d}с**",
            color=0x3498db
        )
        embed.set_footer(text=f"Запросил {ctx.author.name}")
        await ctx.send(embed=embed)

async def setup(bot):
    await bot.add_cog(Uptime(bot))
