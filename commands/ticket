class AdminPanelView(discord.ui.View):
    @discord.ui.button(label="📋 Список тикетов", style=discord.ButtonStyle.primary)
    async def list_tickets(self, interaction: discord.Interaction, button: discord.ui.Button):
        guild = interaction.guild
        category = discord.utils.get(guild.categories, name="🎫 ТИКЕТЫ")
        if not category:
            await interaction.response.send_message("❌ Нет открытых тикетов.", ephemeral=True)
            return
        tickets = []
        for channel in category.text_channels:
            if "ticket-" in channel.name:
                topic = channel.topic
                author_mention = f"<@{topic}>" if topic else "Неизвестен"
                tickets.append(f"**#{channel.name.split('-')[1]}** | Автор: {author_mention} | Канал: {channel.mention}")
        embed = discord.Embed(
            title="📋 Открытые тикеты", 
            description="\n".join(tickets) if tickets else "Сейчас нет открытых тикетов.", 
            color=0x3498db
        )
        embed.set_footer(text="Система тикетов v1.5.0")
        await interaction.response.send_message(embed=embed, ephemeral=True)
